<!DOCTYPE html>

<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<title><%= templatePath %> | ADO Work Item Creator</title>

	<link rel="stylesheet" href="/css/template.css">
	<link rel="icon" href="data:,">

	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
	<script src="/js/template.js"></script>
</head>

<body style="text-align: center;">
	<h2><%= templatePath.split("/").pop() %></h2>

	<!-- Breadcrumb navigation -->
	<div class="breadcrumb">
		<span>Path: </span>
		<a href="/">Root</a> /
		<% let dirParts = templatePath.split("/").filter(part => part.length > 0); %>
		<% dirParts.forEach((part, index) => { %>
		<a href="/?folder=<%= dirParts.slice(0, index + 1).join("/") %>"><%= part %></a>
		<% if (index < dirParts.length - 1) { %> / <% } %>
		<% }) %>
	</div>

	<!-- Error container -->
	<div class="infoBoxContainer infoBoxError defaultHidden" id="errorContainer">
		<span id="errorMessage"></span>
		<button class="closeInfoBoxButton" onclick="this.parentElement.style.display='none';">X</button>
	</div>

	<!-- Form to create work item based on template -->
	<form id="singleWorkItemForm">
		<!-- EJS to loop through templateVariables and create input for each field -->
		<% templateVariables.forEach(variable => { %>
		<div class="formField">
			<label for="<%= variable %>"><%= variable %>:</label>
			<input class="templateVariable" type="text" id="<%= variable %>" name="<%= variable %>" required />
		</div>
		<% }) %>

		<button type="submit">Create Work Item</button>
	</form>
</body>

</html>
